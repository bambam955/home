---
import '../styles/global.css';
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description?: string;
  showBreadcrumbs?: boolean;
  // SEO props
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = 'Personal website of Bennett Moore - Christian, musician, and software developer',
  showBreadcrumbs = true,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import MatrixRain from 'src/components/dev/MatrixRain.astro';

type PageType = 'default' | 'dev';
const pageType: PageType = Astro.url.pathname.startsWith('/dev') ? 'dev' : 'default';

const bodyStyles = {
  default: 'bg-gray-dark text-gray-text font-sans',
  dev: 'bg-gray-dark text-gray-text font-mono',
};

const bodyClass = bodyStyles[pageType] + ' min-h-screen';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- SEO Component -->
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;500;600;700&family=Nunito+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    {pageType === 'dev' && <MatrixRain />}
    <div class="relative z-10">
      <Header />
      {showBreadcrumbs && <Breadcrumbs />}
      <slot />
      <Footer />
    </div>
  </body>
</html>

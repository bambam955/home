---
import '../styles/global.css';
import '../styles/headings.css';

export interface Props {
  title: string;
  description?: string;
  showBreadcrumbs?: boolean;
}

const {
  title,
  description = 'A developer portfolio built with Astro',
  showBreadcrumbs = true,
} = Astro.props;

import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import MatrixRain from 'src/components/dev/MatrixRain.astro';

type PageType = 'default' | 'dev';
const pageType: PageType = Astro.url.pathname.startsWith('/dev') ? 'dev' : 'default';

const bodyStyles = {
  default: 'bg-gray-dark text-gray-text font-sans',
  dev: 'bg-gray-dark text-gray-text font-mono',
};

const bodyClass = bodyStyles[pageType] + ' min-h-screen';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;500;600;700&family=Nunito+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    {pageType === 'dev' && <MatrixRain />}
    <div class="relative z-10">
      <Header />
      {showBreadcrumbs && <Breadcrumbs />}
      <slot />
      <Footer />
    </div>
  </body>
</html>

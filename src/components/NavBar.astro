---
const mainNavItems = [
  {
    title: 'Home',
    route: '/',
  },
  {
    title: 'About',
    route: '/about',
  },
  {
    title: 'Projects',
    route: '/projects',
  },
  {
    title: 'Blog',
    route: '/blog',
  },
];
---

<aside
  class="my-6 w-48 sticky text-white flex flex-col p-4 left-0 top-0 border-r-2 border-r-surface-200 dark:border-r-surface-700"
>
  <!-- TODO: add a logo here -->
  <div class="pt-12"></div>

  <!-- Navigation Links -->
  <nav class="flex-1">
    <ul class="space-y-4">
      {
        mainNavItems.map((linkItem) => (
          <li>
            <a
              class="block text-surface-700 dark:text-surface-300"
              href={linkItem.route}
            >
              {linkItem.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Social Links -->
  <div class="mt-8 flex space-x-4">
    <a href="https://github.com/yourusername" target="_blank">🐙</a>
    <a href="https://linkedin.com/in/yourusername" target="_blank">💼</a>
    <a href="https://twitter.com/yourusername" target="_blank">🐦</a>
  </div>
</aside>

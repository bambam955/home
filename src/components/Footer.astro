---
import TextButton from './buttons/TextButton.astro';
import MailIcon from './icons/MailIcon.astro';
import GithubIcon from './icons/GithubIcon.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';
---

<footer class="bg-gray-medium border-t border-gray-light py-8">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="text-center md:text-left">
        <h3 class="mb-2">Get in Touch</h3>
        <p class="text-gray-dim">
          Feel free to reach out for collaborations, music opportunities, or just a friendly hello!
        </p>
      </div>
      <div class="flex gap-4">
        <a
          href="mailto:hi@bemoore.life"
          class="text-gray-dim hover:text-gradient-primary transition-all p-2"
          aria-label="Send me an email"
        >
          <MailIcon />
        </a>
        <a
          href="https://github.com/bambam955"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-dim hover:text-gradient-primary transition-all p-2"
          aria-label="Visit my GitHub profile"
        >
          <GithubIcon />
        </a>
        <a
          href="https://www.linkedin.com/in/bennett-a-moore/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-dim hover:text-gradient-primary transition-all p-2"
          aria-label="Visit my LinkedIn profile"
        >
          <LinkedinIcon />
        </a>
      </div>
    </div>
    <div class="mt-4 pt-4 border-t border-gray-light text-center text-gray-dim text-sm">
      <p>
        Curated with care by Bennett Moore. No rights reserved. Built with
        <TextButton href="https://astro.build/" target="_blank"> Astro </TextButton>.
      </p>
    </div>
  </div>
</footer>

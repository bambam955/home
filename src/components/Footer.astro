---
import GithubIcon from './icons/GithubIcon.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';
---

<footer class="bg-gray-medium border-t border-gray-light py-12">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="text-center md:text-left">
        <h3 class="text-xl font-bold mb-2 text-green-primary">Get in Touch</h3>
        <p class="text-gray-dim">
          Feel free to reach out for collaborations or just a friendly hello!
        </p>
      </div>
      <div class="flex gap-4">
        <a
          href="https://github.com/bambam955"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-dim hover:text-green-primary transition-colors p-2"
        >
          <GithubIcon />
        </a>
        <a
          href="https://www.linkedin.com/in/bennett-a-moore/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-dim hover:text-green-primary transition-colors p-2"
        >
          <LinkedinIcon />
        </a>
        <!-- <a
          href="mailto:contact@example.com"
          class="text-gray-dim hover:text-green-primary transition-colors p-2"
        >
          <ExternalLinkIcon />
        </a> -->
      </div>
    </div>
    <div
      class="mt-8 pt-8 border-t border-gray-light text-center text-gray-dim text-sm"
    >
      <p>
        Made for sharing by Bennett Moore. No rights reserved. Built with Astro.
      </p>
    </div>
  </div>
</footer>

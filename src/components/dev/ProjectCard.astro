---
import type SoftwareProject from 'src/data/dev/types';
import TextButton from 'src/components/buttons/TextButton.astro';

export interface Props {
  project: SoftwareProject;
}

const { project } = Astro.props;
---

<div
  class="bg-gray-dark border border-gray-light hover:bg-gradient-primary hover:border-transparent transition-all duration-300 p-6 rounded-lg shadow-soft hover:shadow-soft-lg"
>
  <h3 class="text-xl font-bold mb-3 text-gradient-accent hover:text-gradient-primary">
    {project.title}
  </h3>
  <p class="text-gray-dim mb-4 hover:text-gray-text">{project.description}</p>
  <div class="flex flex-wrap gap-2 mb-4">
    {
      project.tags.map((tag) => (
        <span class="bg-gray-medium text-gray-text px-3 py-1 rounded-full text-sm hover:text-gradient-primary">
          {tag}
        </span>
      ))
    }
  </div>
  <div class="flex gap-4">
    <TextButton href={project.github} target="_blank" rel="noopener noreferrer">GitHub</TextButton>
    {
      project.demo && (
        <TextButton href={project.demo} target="_blank" rel="noopener noreferrer">
          Live Demo
        </TextButton>
      )
    }
  </div>
</div>

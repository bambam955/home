---
export interface Props {
  title?: string;
  children?: any;
}

const { title = "Terminal", children } = Astro.props;
---

<div class="bg-gray-terminal border-2 border-gray-border overflow-hidden shadow-blocky">
  <div class="bg-green-dark px-4 py-2 flex items-center gap-2 border-b border-gray-border">
    <div class="w-3 h-3 bg-red-500"></div>
    <div class="w-3 h-3 bg-yellow-500"></div>
    <div class="w-3 h-3 bg-green-primary"></div>
    <span class="ml-4 text-gray-dim text-sm font-mono">{title}</span>
  </div>
  <div class="p-4 font-mono text-sm text-green-primary">
    <slot />
  </div>
</div>

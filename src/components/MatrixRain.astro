---
// Simple Matrix Rain Component
---

<canvas id="matrix-rain" class="fixed top-0 left-0 w-full h-full pointer-events-none z-0"></canvas>

<script>
  class MatrixRain {
    constructor() {
      this.canvas = document.getElementById('matrix-rain');
      if (!this.canvas) return;

      this.ctx = this.canvas.getContext('2d');
      this.characters =
        '01{}()[]<>;/functionconstletvarifelseforwhileclassimportexportfromreturnasyncawaittrycatchfinallythrownewthis';
      this.fontSize = 14;
      this.drops = [];
      this.lastTime = 0;
      this.frameInterval = 50;

      this.init();
      this.animate();

      window.addEventListener('resize', () => this.init());
    }

    init() {
      this.canvas.width = window.innerWidth;
      this.canvas.height = window.innerHeight;
      this.columns = Math.floor(this.canvas.width / this.fontSize);

      this.drops = [];
      for (let i = 0; i < this.columns; i++) {
        this.drops[i] = Math.random() * -100;
      }
    }

    animate(currentTime = 0) {
      requestAnimationFrame((time) => this.animate(time));

      if (currentTime - this.lastTime < this.frameInterval) return;
      this.lastTime = currentTime;

      this.ctx.fillStyle = 'rgba(2, 6, 23, 0.05)';
      this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

      this.ctx.fillStyle = '#00d992';
      this.ctx.font = `${this.fontSize}px 'JetBrains Mono', monospace`;
      this.ctx.globalAlpha = 0.3;

      for (let i = 0; i < this.drops.length; i++) {
        const char = this.characters[Math.floor(Math.random() * this.characters.length)];
        const x = i * this.fontSize;
        const y = this.drops[i] * this.fontSize;

        const opacity = Math.max(0, 1 - y / this.canvas.height);
        this.ctx.globalAlpha = opacity * 0.3;

        this.ctx.fillText(char, x, y);

        if (y > this.canvas.height && Math.random() > 0.975) {
          this.drops[i] = 0;
        }

        this.drops[i]++;
      }

      this.ctx.globalAlpha = 1;
    }
  }

  // Simple initialization
  document.addEventListener('DOMContentLoaded', () => {
    new MatrixRain();
  });
</script>

<style>
  #matrix-rain {
    opacity: 0.7;
  }
</style>

---
import type SoftwareProject from '../data/types';

export interface Props {
  project: SoftwareProject;
}

const { project } = Astro.props;
---

<div
  class="project-card relative bg-gray-dark border border-gray-light hover:border-peach-light/40 hover:bg-gradient-primary transition-all duration-300 p-6 rounded-lg shadow-soft hover:shadow-soft-lg cursor-pointer"
  data-primary-link={project.primaryLink}
>
  <h3 class="text-xl font-bold mb-3 text-gradient-accent hover:text-gradient-primary">
    {project.title}
  </h3>
  <p class="text-gray-dim mb-4">{project.description}</p>
  <div class="flex flex-wrap gap-2 mb-4">
    {
      project.tags.map((tag) => (
        <span class="bg-gray-medium text-gray-text px-3 py-1 rounded-full text-sm hover:text-gradient-primary">
          {tag}
        </span>
      ))
    }
  </div>
  <div class="flex gap-4">
    {
      project.links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link text-gradient-primary hover:text-gradient-accent transition-all"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</div>

<script>
  function initProjectCards() {
    document.querySelectorAll('.project-card').forEach((card) => {
      card.addEventListener('click', (e) => {
        // Don't navigate if clicking on a link
        if ((e.target as HTMLElement).closest('.project-link')) return;

        const url = card.getAttribute('data-primary-link');
        if (url) window.open(url, '_blank');
      });
    });
  }

  initProjectCards();
  document.addEventListener('astro:after-swap', initProjectCards);
</script>

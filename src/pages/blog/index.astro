---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Blog | Developer Portfolio">
  <main class="min-h-screen py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold mb-12 text-center text-green-primary">Blog</h1>

      <div class="space-y-8">
        <article class="bg-gray-medium rounded-lg p-6 shadow-soft">
          <h2 class="text-2xl font-bold mb-3 text-green-primary">
            <a
              href="/blog/getting-started-with-astro"
              class="hover:text-green-accent transition-colors"
            >
              Getting Started with Astro
            </a>
          </h2>
          <p class="text-gray-dim mb-4">
            Learn how to build fast, modern websites with Astro and its island architecture.
          </p>
          <div class="flex items-center gap-4 text-sm text-gray-dim">
            <span>March 15, 2024</span>
            <span>•</span>
            <span>5 min read</span>
          </div>
        </article>

        <article class="bg-gray-medium rounded-lg p-6 shadow-soft">
          <h2 class="text-2xl font-bold mb-3 text-green-primary">
            <a href="/blog/react-best-practices" class="hover:text-green-accent transition-colors">
              React Best Practices in 2024
            </a>
          </h2>
          <p class="text-gray-dim mb-4">
            Discover the latest best practices for building scalable React applications.
          </p>
          <div class="flex items-center gap-4 text-sm text-gray-dim">
            <span>March 10, 2024</span>
            <span>•</span>
            <span>8 min read</span>
          </div>
        </article>

        <article class="bg-gray-medium rounded-lg p-6 shadow-soft">
          <h2 class="text-2xl font-bold mb-3 text-green-primary">
            <a href="/blog/tailwind-css-tips" class="hover:text-green-accent transition-colors">
              Tailwind CSS Tips and Tricks
            </a>
          </h2>
          <p class="text-gray-dim mb-4">
            Master Tailwind CSS with these advanced techniques and productivity tips.
          </p>
          <div class="flex items-center gap-4 text-sm text-gray-dim">
            <span>March 5, 2024</span>
            <span>•</span>
            <span>6 min read</span>
          </div>
        </article>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = 'Welcome!!!';
---

<BaseLayout title={pageTitle}>
  <h1 class="text-4xl font-bold text-gray-900">
    {pageTitle}
  </h1>

  <section
    class="w-full max-w-xl rounded-xl shadow-lg p-8 bg-white text-black dark:bg-gray-900 dark:text-white transition-colors duration-300"
  >
    <h2 class="text-2xl font-semibold mb-4">See the Difference</h2>
    <p class="mb-2">
      This section uses <code
        >bg-white text-black dark:bg-gray-900 dark:text-white</code
      > classes.
    </p>
    <ul class="list-disc pl-6">
      <li>Light mode: white background, black text</li>
      <li>Dark mode: dark gray background, white text</li>
    </ul>
  </section>

  <section
    class="w-full max-w-xl rounded-xl shadow-lg p-8 bg-blue-100 text-blue-900 dark:bg-blue-900 dark:text-blue-100 transition-colors duration-300"
  >
    <h2 class="text-2xl font-semibold mb-4">Another Example</h2>
    <p>This box uses color classes that also change in dark mode.</p>
  </section>
</BaseLayout>

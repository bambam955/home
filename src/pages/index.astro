---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillsWeb from '../components/SkillsWeb.astro';
import { projects } from '../data/projects';

const featuredProjects = projects.filter((p) => p.featured);
---

<Layout title="Home | Developer Portfolio" showBreadcrumbs={false}>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 text-green-primary">
          Hey, I'm Bennett Moore!
        </h1>
        <p class="text-xl text-gray-dim mb-8">
          Building amazing software projects with a variety of technologies
        </p>
        <div class="flex gap-4 justify-center">
          <a
            href="/projects"
            class="bg-green-primary hover:bg-green-accent text-green-darker px-6 py-3 rounded-lg transition-colors"
          >
            View Projects
          </a>
          <a
            href="/about"
            class="border border-green-primary hover:bg-green-primary hover:text-green-darker text-green-primary px-6 py-3 rounded-lg transition-colors"
          >
            About Me
          </a>
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="py-20 px-4 bg-gray-medium/30">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-12 text-green-primary">Featured Projects</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="py-20 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-12 text-green-primary">
          Skills & Technologies
        </h2>
        <div class="mb-8 text-center">
          <p class="text-gray-dim max-w-2xl mx-auto">
            Interactive visualization of my skills. Click any skill's node to highlight connections.
            Larger nodes represent areas of deeper expertise.
          </p>
        </div>
        <SkillsWeb />
      </div>
    </section>
  </main>

  <Footer />
</Layout>

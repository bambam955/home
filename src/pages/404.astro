---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 - Page Not Found">
  <Header />

  <main class="min-h-screen flex items-center justify-center px-4">
    <div class="text-center">
      <div class="bg-gray-medium rounded-lg p-8 shadow-soft mb-8">
        <div class="text-6xl font-bold mb-4 text-green-primary">404</div>
        <h2 class="text-2xl font-semibold mb-4 text-gray-dim">
          Page Not Found
        </h2>
        <p class="text-gray-dim mb-8">
          The page you are looking for does not exist.
        </p>
      </div>
      <a
        href="/"
        class="bg-green-primary hover:bg-green-accent text-green-darker px-6 py-3 rounded-lg transition-colors"
      >
        Go Home
      </a>
    </div>
  </main>

  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 - Page Not Found">
  <Header />

  <main class="flex items-center justify-center px-4 min-h-screen">
    <div class="text-center">
      <div class="bg-gray-medium rounded-lg p-8 px-16 shadow-soft mb-8">
        <div class="text-6xl font-bold mb-4 text-green-primary">404</div>
        <h2 class="text-2xl font-semibold mb-4 text-gray-dim">Page Not Found</h2>
        <p class="text-gray-dim mb-8">The page you are looking for does not exist.</p>
        <a
          href="/"
          class="inline-block bg-green-primary hover:bg-green-accent transition-colors rounded-lg px-8 py-3 text-green-darker font-semibold"
        >
          Go Home
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
